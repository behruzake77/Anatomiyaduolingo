# Supabase public browser configuration.
# VITE_* is the canonical name for the Vite build.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Existing Render deployments may keep these names temporarily.
# The app accepts them too, but prefer renaming them to VITE_*.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key