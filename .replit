modules = ["nodejs-20", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CORPUS Anatomy Learning"

[[workflows.workflow]]
name = "CORPUS Anatomy Learning"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=22229 BASE_PATH=/ pnpm --filter @workspace/corpus run dev"
waitForPort = 22229

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
