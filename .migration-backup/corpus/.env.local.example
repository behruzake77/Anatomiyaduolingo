# ===========================================
# CORPUS — Subabase Environment Variables
# ===========================================
# 
# 1. supabase.com saytida yangi loyiha yarating
# 2. Settings → API bo'limidan quyidagilarni nusxa oling
# 3. Bu faylni .env.local ga nusxa qilib, qiymatlarni joylashtiring
#

# Supabase Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Supabase Anonymous Key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Email tasdiqlash (OTP kod):
# Authentication → Providers → Email → Confirm email: ON
# Authentication → Email Templates → Confirm signup: {{ .Token }} (6 xonali kod)
# Render.com da NEXT_PUBLIC_* o'zgaruvchilar BUILD paytida bo'lishi shart (redeploy).

# ===========================================
# OPTIONAL: Service Role Key (faqat server tomonida)
# ===========================================
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
